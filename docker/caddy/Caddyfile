{
	# HTTPS automatique ; Cloudflare en amont (R3). Journaux d'accès au format JSON.
	email {$CADDY_ACME_EMAIL:admin@example.invalid}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

{$SERVER_NAME:localhost} {
	root * /app/public
	encode zstd gzip

	# Les en-têtes applicatifs (CSP avec nonce) sont posés par Symfony ;
	# Caddy garantit les en-têtes de base, y compris sur les fichiers statiques.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000 {
		root /app/public
	}
	file_server

	log {
		output stdout
		format json
	}
}
