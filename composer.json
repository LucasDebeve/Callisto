{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.19.3",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7.6",
        "league/commonmark": "^2.10.7",
        "scheb/2fa-backup-code": "^7.14",
        "scheb/2fa-bundle": "^7.14",
        "scheb/2fa-totp": "^7.14",
        "scrivo/highlight.php": "^9.18.1.10",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/flex": "^2.12",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/html-sanitizer": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "twig/extra-bundle": "^3.29"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "use-github-api": false
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "services": [
            "docker compose up -d --wait"
        ],
        "setup": [
            "@services",
            "@php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration",
            "@php bin/console callisto:content:import --yes",
            "@php bin/console callisto:demo:load",
            "@php bin/console tailwind:build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@services",
            "@php bin/dev"
        ],
        "test": [
            "@services",
            "@php vendor/bin/phpunit"
        ],
        "qa": [
            "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
            "@php bin/console cache:warmup --env=dev",
            "@php tools/phpstan/vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/process": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "repositories": {},
    "scripts-descriptions": {
        "services": "Démarre les services Docker de développement (PostgreSQL).",
        "setup": "Prépare l'environnement : services, migrations, contenus, démonstration, feuille de style.",
        "dev": "Lance l'application en local (serveur PHP + Tailwind en surveillance) avec les services Docker.",
        "test": "Lance la suite de tests.",
        "qa": "Formatage, analyse statique et tests, comme la CI."
    }
}
