{% for type, messages in app.flashes(['success', 'error', 'info']) %}
    {% for message in messages %}
        <div class="alert alert-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
            {{ icon(type == 'success' ? 'circle-check' : (type == 'error' ? 'triangle-alert' : 'info')) }}
            <p>{{ message }}</p>
        </div>
    {% endfor %}
{% endfor %}
