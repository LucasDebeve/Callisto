{% extends 'base.html.twig' %}

{% set code = status_code|default(500) %}
{% block title %}{{ code == 404 ? 'Page introuvable' : (code == 403 ? 'Accès refusé' : 'Erreur') }}{% endblock %}

{% block body %}
<main id="contenu" class="flex min-h-screen items-center justify-center p-6" tabindex="-1">
    <div class="w-full max-w-md text-center">
        {% include 'components/_empty.html.twig' with {message: code == 404 ? 'Cette page s\'est perdue dans l\'espace.' : (code == 403 ? 'Cette zone n\'est pas accessible avec ton compte.' : (code == 429 ? 'Trop de demandes. Patiente un instant.' : 'Un problème est survenu. Réessaie dans un moment.')), hint: 'Erreur ' ~ code ~ '.'} %}
        <a class="btn btn-primary" href="{{ path('home') }}">{{ icon('house') }}Retour à l'accueil</a>
    </div>
</main>
{% endblock %}
