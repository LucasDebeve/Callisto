{% extends 'layout/teacher.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="no-print mb-6">
    <h1 class="mb-2">{{ title }}</h1>
    <div class="alert alert-info" role="status">{{ icon('info') }}<p>Cette liste ne sera plus jamais affichée : imprime-la maintenant. Chaque élève devra changer son mot de passe à la première connexion.</p></div>
    <div class="flex flex-wrap gap-3">
        <p class="muted text-sm">Utilise la fonction Imprimer du navigateur (Ctrl+P).</p>
        <a class="btn btn-secondary" href="{{ path('teacher_classes') }}">Retour aux classes</a>
    </div>
</div>
<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {% for entry in entries %}
        <div class="card print-sheet card-tight">
            <p class="eyebrow">Callisto · {{ entry.user.schoolClass ? entry.user.schoolClass.name : '' }}</p>
            <p class="text-lg font-semibold">{{ entry.user.displayName }}</p>
            <p>Identifiant : <code class="font-mono">{{ entry.user.username }}</code></p>
            <p>Mot de passe provisoire : <code class="font-mono">{{ entry.password }}</code></p>
        </div>
    {% endfor %}
</div>
{% endblock %}
