{% extends 'base.html.twig' %}

{% block title %}Double authentification{% endblock %}
{% block body_class %}space-teacher{% endblock %}

{% block body %}
<main id="contenu" class="flex min-h-screen items-center justify-center p-6" tabindex="-1">
    <div class="card w-full max-w-sm">
        <p class="mb-6"><span class="space-label">{{ icon('graduation-cap', 'icon-sm') }}Espace enseignant</span></p>
        <h1 class="mb-2">Code de vérification</h1>
        <p class="muted mb-6">Saisis le code à 6 chiffres de ton application d'authentification, ou un code de secours.</p>
        {% if authenticationError %}
            <div class="alert alert-error" role="alert" id="code-error">{{ icon('triangle-alert') }}<p>Code incorrect ou déjà utilisé.</p></div>
        {% endif %}
        <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}">
            <div class="field">
                <label class="field-label" for="_auth_code">Code</label>
                <input class="field-input font-mono text-lg" id="_auth_code" name="{{ authCodeParameterName }}" autocomplete="one-time-code" inputmode="text" autocapitalize="characters" required autofocus {% if authenticationError %}aria-invalid="true" aria-describedby="code-error"{% endif %}>
            </div>
            {% if isCsrfProtectionEnabled %}<input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">{% endif %}
            <button class="btn btn-primary w-full" type="submit">Vérifier</button>
        </form>
        <p class="mt-4 text-sm"><a href="{{ logoutPath }}">Annuler</a></p>
    </div>
</main>
{% endblock %}
