{% extends 'layout/teacher.html.twig' %}

{% block title %}Journal d'audit{% endblock %}

{% block content %}
<h1 class="mb-6">Journal d'audit</h1>
<form method="get" class="mb-4 flex flex-wrap items-end gap-3">
    <div class="field mb-0!">
        <label class="field-label" for="action">Action</label>
        <select class="field-input" id="action" name="action">
            <option value="">Toutes</option>
            {% for a in actions %}<option value="{{ a }}" {% if a == action %}selected{% endif %}>{{ a|replace({'_': ' '}) }}</option>{% endfor %}
        </select>
    </div>
    <div class="field mb-0!">
        <label class="field-label" for="qui">Compte concerné</label>
        <input class="field-input" id="qui" name="qui" value="{{ actor }}">
    </div>
    <button class="btn btn-secondary" type="submit">Filtrer</button>
</form>
{% if entries is empty %}
    {% include 'components/_empty.html.twig' %}
{% else %}
<div class="table-wrap card p-0!">
    <table class="data-table">
        <thead><tr><th scope="col">Date</th><th scope="col">Action</th><th scope="col">Auteur</th><th scope="col">Concerne</th><th scope="col">Détails</th><th scope="col">IP</th></tr></thead>
        <tbody>
            {% for e in entries %}
                <tr>
                    <td class="whitespace-nowrap">{{ e.occurredAt|date('d/m/Y H:i:s') }}</td>
                    <td>{{ e.action|replace({'_': ' '}) }}</td>
                    <td>{{ e.actor ?? '—' }}</td>
                    <td>{{ e.subject ?? '—' }}</td>
                    <td class="text-sm">{% for k, v in e.details %}{{ k }} : {{ v }}{{ not loop.last ? ' · ' }}{% endfor %}</td>
                    <td class="text-sm">{{ e.ipAddress ?? '—' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<nav class="mt-4 flex gap-3" aria-label="Pages">
    {% if page > 1 %}<a class="btn btn-secondary btn-sm" href="{{ path('teacher_audit', {page: page - 1, action: action, qui: actor}) }}">{{ icon('chevron-left', 'icon-sm') }}Plus récents</a>{% endif %}
    {% if hasNext %}<a class="btn btn-secondary btn-sm" href="{{ path('teacher_audit', {page: page + 1, action: action, qui: actor}) }}">Plus anciens{{ icon('chevron-right', 'icon-sm') }}</a>{% endif %}
</nav>
{% endif %}
{% endblock %}
