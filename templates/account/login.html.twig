{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<main id="contenu" class="grid min-h-screen lg:grid-cols-2" tabindex="-1">
    <div class="login-sky relative hidden lg:block">{% include 'components/_login_sky.html.twig' %}</div>
    <div class="flex items-center justify-center p-6">
        <div class="w-full max-w-sm">
            <p class="logo mb-6">{% include 'components/_logo.html.twig' %}<span>Callisto</span></p>
            <h1 class="mb-2">Connexion</h1>
            <p class="muted mb-6">Retrouve ton ciel : cours, QCM et progression.</p>

            {% include 'components/_flashes.html.twig' %}
            {% if expired %}
                <div class="alert alert-info" role="status">{{ icon('info') }}<p>Ta session a expiré après une période d'inactivité. Reconnecte-toi.</p></div>
            {% endif %}
            {% if error %}
                <div class="alert alert-error" role="alert" id="login-error">
                    {{ icon('triangle-alert') }}
                    <p>{% if error.messageKey starts with 'Too many' %}Trop d'essais. Patiente quelques minutes avant de réessayer.{% else %}Identifiant ou mot de passe incorrect.{% endif %}</p>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" novalidate>
                <div class="field">
                    <label class="field-label" for="username">Identifiant</label>
                    <input class="field-input" type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                </div>
                <div class="field">
                    <label class="field-label" for="password">Mot de passe</label>
                    <input class="field-input" type="password" id="password" name="_password" autocomplete="current-password" required {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn-primary w-full" type="submit">{{ icon('log-in') }}Se connecter</button>
            </form>
            <p class="muted mt-6 text-sm">Mot de passe oublié ? Demande à ton enseignant de le réinitialiser en classe.</p>
            <p class="mt-4 text-sm"><a href="{{ path('course_index') }}">Consulter les cours sans se connecter</a> · <a href="{{ path('legal_notice') }}">Confidentialité</a></p>
        </div>
    </div>
</main>
{% endblock %}
