<ul class="rules mb-4" aria-label="Règles du mot de passe">
    <li data-password-rules-target="rule" data-rule="longueur">{{ icon('check', 'icon-sm') }}Au moins 10 caractères <span class="sr-only" data-mark>à respecter</span></li>
    <li data-password-rules-target="rule" data-rule="sortes">{{ icon('check', 'icon-sm') }}Au moins deux sortes de caractères (lettres, chiffres, symboles) <span class="sr-only" data-mark>à respecter</span></li>
    <li data-password-rules-target="rule" data-rule="identifiant">{{ icon('check', 'icon-sm') }}Ne contient pas ton identifiant <span class="sr-only" data-mark>à respecter</span></li>
    <li data-password-rules-target="rule" data-rule="identiques">{{ icon('check', 'icon-sm') }}Les deux saisies sont identiques <span class="sr-only" data-mark>à respecter</span></li>
    <li>{{ icon('info', 'icon-sm') }}Les mots de passe trop courants sont refusés.</li>
</ul>
