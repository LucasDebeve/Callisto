{% extends 'base.html.twig' %}

{% block title %}Choisis ton mot de passe{% endblock %}

{% block body %}
<main id="contenu" class="flex min-h-screen items-center justify-center p-6" tabindex="-1">
    <div class="card w-full max-w-md">
        <p class="logo mb-4">{% include 'components/_logo.html.twig' %}<span>Callisto</span></p>
        <h1 class="mb-2">Choisis ton mot de passe</h1>
        <p class="muted mb-6">Ton mot de passe provisoire ne sert qu'une fois. Choisis-en un que tu es seul à connaître.</p>
        <div data-controller="password-rules" data-password-rules-username-value="{{ username }}" data-password-rules-min-value="10">
            {{ form_start(form) }}
                {% include 'account/_password_rules.html.twig' %}
                {{ form_row(form.newPassword.first) }}
                {{ form_row(form.newPassword.second) }}
                {{ form_rest(form) }}
                <button class="btn btn-primary w-full" type="submit">Enregistrer mon mot de passe</button>
            {{ form_end(form) }}
        </div>
        <p class="mt-4 text-sm"><a href="{{ path('app_logout') }}">Se déconnecter</a></p>
    </div>
</main>
{% endblock %}
