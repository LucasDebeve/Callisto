{# Constellation d'un thème : vue carte (SVG) et vue liste équivalente. Variables : theme, map, selected, lighting, histories, subject, baseUrl, coursesByItem #}
<div data-controller="view-toggle">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <p class="font-semibold">{{ map.validated }} sur {{ map.total }} validés{% if map.total > 0 and map.validated == map.total %} · <span class="badge badge-valide">{{ icon('check', 'icon-sm') }}Constellation complète</span>{% endif %}</p>
        <div class="flex gap-2" role="group" aria-label="Choix de la vue">
            <button type="button" class="btn btn-secondary btn-sm" data-view="carte" data-view-toggle-target="button" data-action="view-toggle#choose" aria-pressed="true">{{ icon('waypoints', 'icon-sm') }}Constellation</button>
            <button type="button" class="btn btn-secondary btn-sm" data-view="liste" data-view-toggle-target="button" data-action="view-toggle#choose" aria-pressed="false">{{ icon('list', 'icon-sm') }}Liste</button>
        </div>
    </div>

    {% if map.stars is empty %}
        {% include 'components/_empty.html.twig' with {message: 'Rien ici pour l\'instant.'} %}
    {% else %}
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]" data-controller="constellation">
        <div>
            <div data-view-toggle-target="map">
                <div class="sky-frame">
                    <div class="sky-tools" role="group" aria-label="Se déplacer dans la constellation" data-constellation-target="tools" hidden>
                        <button type="button" class="sky-tool" data-action="constellation#zoomIn" aria-label="Rapprocher">{{ icon('plus', 'icon-sm') }}</button>
                        <button type="button" class="sky-tool" data-action="constellation#zoomOut" aria-label="Éloigner">{{ icon('minus', 'icon-sm') }}</button>
                        <button type="button" class="sky-tool" data-action="constellation#reset" aria-label="Voir toute la constellation">{{ icon('scan', 'icon-sm') }}</button>
                    </div>
                    <svg class="sky" data-constellation-target="svg" viewBox="0 0 {{ map.width }} {{ map.height }}" preserveAspectRatio="xMidYMid meet" role="group" aria-label="Constellation {{ theme.title }} : {{ map.validated }} étoiles allumées sur {{ map.total }}. La vue liste donne les mêmes informations.">
                        <defs>
                            <radialGradient id="sky-glow"><stop offset="0" class="glow-core"/><stop offset="1" class="glow-edge"/></radialGradient>
                        </defs>
                        <g class="sky-dust is-far" data-constellation-target="far" aria-hidden="true">
                            {% set fw = (map.width * 1.4)|round %}{% set fh = (map.height * 1.4)|round %}
                            {% for i in 1..70 %}<circle cx="{{ (i * 137) % fw - (map.width * 0.2)|round }}" cy="{{ (i * 89) % fh - (map.height * 0.2)|round }}" r="{{ i % 3 == 0 ? 1.3 : 0.8 }}"/>{% endfor %}
                        </g>
                        <g class="sky-dust" aria-hidden="true">
                            {% set w = map.width|round %}{% set h = map.height|round %}
                            {% for i in 1..24 %}<circle cx="{{ (i * 211) % w }}" cy="{{ (i * 157) % h }}" r="{{ i % 4 == 0 ? 1.8 : 1.1 }}"/>{% endfor %}
                        </g>
                        <g class="sky-links" aria-hidden="true">
                            {% for link in map.links %}
                                {% set drawing = link.from in lighting %}
                                <path class="sky-link is-{{ link.state }}{{ drawing ? ' is-drawing' : '' }}" d="{{ link.path }}" data-from="{{ link.from }}" data-to="{{ link.to }}" data-constellation-target="link" {% if drawing %}pathLength="1"{% endif %}/>
                            {% endfor %}
                        </g>
                        {% for star in map.stars %}{% include 'progress/_star.html.twig' %}{% endfor %}
                    </svg>
                    <p class="sky-hint" data-constellation-target="hint" hidden>Glisser pour se déplacer · Ctrl + molette pour zoomer</p>
                </div>
                <ul class="sky-legend" aria-label="Légende">
                    <li>{% include 'components/_type_icon.html.twig' with {type: enum('App\\Referential\\Domain\\ItemType').Knowledge} %}Savoir</li>
                    <li>{% include 'components/_type_icon.html.twig' with {type: enum('App\\Referential\\Domain\\ItemType').Skill} %}Savoir-faire</li>
                    <li>{% include 'components/_type_icon.html.twig' with {type: enum('App\\Referential\\Domain\\ItemType').Competency} %}Compétence</li>
                    <li>{{ icon('check', 'icon-sm') }}remplie : validée</li>
                    <li>{{ icon('circle-dashed', 'icon-sm') }}contour plein : disponible</li>
                    <li>{{ icon('lock', 'icon-sm') }}pointillés : prérequis à valider</li>
                </ul>
                {% if map.external is not empty %}
                    <p class="muted mt-2 text-sm">Prérequis venant d'autres constellations :
                        {% for e in map.external %}{{ e.item.title }} ({{ e.status.label|lower }}){{ not loop.last ? ', ' }}{% endfor %}.</p>
                {% endif %}
            </div>

            <div data-view-toggle-target="list" class="mt-6">
                <h2 class="sr-only">Vue liste</h2>
                {% set currentChapter = null %}
                <ul class="sky-rows">
                    {% for star in map.stars %}
                        {% if star.item.chapter.code != currentChapter %}
                            {% set currentChapter = star.item.chapter.code %}
                            <li><h3 class="sky-row-head">{{ star.item.chapter.title }}</h3></li>
                        {% endif %}
                        <li class="sky-row">
                            <div class="flex min-w-0 items-start gap-3">
                                <span class="mt-1">{% include 'components/_type_icon.html.twig' with {type: star.item.type} %}</span>
                                <div>
                                    <p class="font-semibold">{{ star.item.title }}</p>
                                    <p class="muted text-sm">{{ star.item.type.label }}{% if star.prerequisites is not empty %} · Prérequis : {% for p in star.prerequisites %}{{ p.item.title }}{{ not loop.last ? ', ' }}{% endfor %}{% endif %}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                {% include 'components/_status_badge.html.twig' with {status: star.status, state: star.state} %}
                                <a class="btn btn-ghost btn-sm" href="{{ baseUrl }}?etoile={{ star.item.code }}" data-code="{{ star.item.code }}" data-action="constellation#open">Détails<span class="sr-only"> : {{ star.item.title }}</span></a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <aside class="side-panel" aria-label="Détails de l'étoile" aria-live="polite" data-constellation-target="panel">
            {% set any = selected in map.stars|map(s => s.item.code) %}
            {% for star in map.stars %}
                {% set visible = selected == star.item.code %}
                {% include 'progress/_star_detail.html.twig' %}
            {% endfor %}
            <div data-constellation-target="detail" data-code="" {% if any %}hidden{% endif %}>
                <p class="muted">Choisis une étoile (clic ou touche Entrée) pour voir son état, ses prérequis et son historique.</p>
            </div>
        </aside>
    </div>
    {% endif %}
</div>
