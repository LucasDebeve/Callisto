# Valeurs par défaut versionnées, sans aucun secret réel (S18).
# Surcharger dans .env.local (non versionné) ou par les variables d'environnement / secrets Symfony.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://callisto:callisto@127.0.0.1:5432/callisto?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> callisto ###
# Dossier du dépôt de contenus (Markdown + YAML) à importer.
CALLISTO_CONTENT_DIR=%kernel.project_dir%/content
# Dossier de stockage des pièces jointes importées.
CALLISTO_FILES_DIR=%kernel.project_dir%/var/content-files
###< callisto ###

###> symfonycasts/tailwind-bundle ###
# Laisser vide pour télécharger le binaire épinglé ; sinon chemin vers un binaire tailwindcss local.
TAILWIND_BINARY=
###< symfonycasts/tailwind-bundle ###
